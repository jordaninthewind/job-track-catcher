{
  "manifest_version": 3,
  "name": "Job Track Catcher",
  "version": "0.2.0",
  "description": "Adds a 'Save Application Data' button next to job application submit buttons and saves your answers as JSON.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Job Track Catcher",
    "default_popup": "popup/index.html"
  },
  "options_page": "options/index.html",
  "minimum_chrome_version": "116"
}
